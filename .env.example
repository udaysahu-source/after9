# ==============================================================================
# AFTER9 — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real keys, production secrets, or service role credentials to Git.
# - SUPABASE_SERVICE_ROLE_KEY and private secrets MUST ONLY be configured in trusted
#   deployment environments (Vercel Project Settings / Lovable Cloud Secrets).
# - Any variable prefixed with VITE_ will be embedded into the browser client bundle.
# ==============================================================================

# --- Public Client Variables (Safe for Frontend / VITE_) ---
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_VAPID_PUBLIC_KEY="your-public-vapid-key"

# --- Server-Side Only Supabase Configuration ---
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"

# PRIVILEGED: Never expose in browser bundles or VITE_ variables
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Administrative Access Controls ---
# Comma-separated list of pre-authorized admin emails (super_admin bootstrap)
ADMIN_EMAILS="admin@example.com"
ADMIN_EMAIL="admin@example.com"

# --- External Service Integrations (Server-Side Secrets) ---
LOVABLE_API_KEY="your-lovable-ai-gateway-api-key"
LOVABLE_CRON_SECRET="your-secure-cron-secret-token"
LOVABLE_CRON_SECRET_PREVIOUS=""
VAPID_PRIVATE_KEY="your-private-vapid-signing-key"
LOVABLE_DB_MIGRATION_URL="postgresql://postgres:password@localhost:5432/postgres"
